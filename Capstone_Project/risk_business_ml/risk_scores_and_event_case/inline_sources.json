      "id": "financial-monitoring-score",
      "title": "FICC 与 ECS 相关业务金融压力监测",
      "queries": [
        {
          "id": "computed-scores",
          "source": {
            "label": "本地公开数据与探索性关联结果",
            "files": [
              "risk_quarterly.csv",
              "risk_business_associations.csv",
              "scoring_summary.json"
            ],
            "links": [
              "https://fred.stlouisfed.org/series/VIXCLS",
              "https://fred.stlouisfed.org/series/DGS10",
              "https://fred.stlouisfed.org/series/NFCICREDIT",
              "https://fred.stlouisfed.org/series/SOFR",
              "https://fred.stlouisfed.org/series/EFFR"
            ],
            "metricDefinitions": [
              {
                "label": "金融压力监测指数",
                "definition": "四项历史压力分位按探索性业务关联权重加权，范围为0至100。"
              },
              {
                "label": "ECS相关代理",
                "definition": "NSCC与DTC法律实体金融监测指数较大值。"
              }
            ],
            "filters": [
              "参考分布：2020Q1至2025Q2，共22个季度",
              "业务关联：三个财务变化指标的最大Spearman绝对值，按四项金融代理归一化"
            ],
            "caveats": [
              "分数是新增的事后监测规则，不是校准的违约概率、真实损失或正式风险等级。",
              "NSCC和DTC包含ECS以外业务，ECS没有独立分部数据。",
              "已有78项关联比较均未通过探索性FDR 5%检查；权重使用截至2026Q2的描述性关联。"
            ],
            "executedAt": "2026-10-05T23:52:34.063542+00:00",
            "evidenceFlow": [
              {
                "kind": "validation",
                "title": "计算复核",
                "body": "独立排序计数与原分位计算一致，权重和为1，分数在0至100范围，ECS聚合一致；等权评分也将2020Q1列为最高季度。"
              }
            ]
          },
          "reportingPeriod": "最新业务季度2026Q2；历史事件季度2020Q1",
          "columns": [
            "季度",
            "FICC监测指数",
            "ECS相关代理指数",
            "NSCC监测指数",
            "DTC监测指数"
          ],
          "rows": [
            {
              "季度": "2026Q2",
              "FICC监测指数": 50.4,
              "ECS相关代理指数": 43.4,
              "NSCC监测指数": 43.4,
              "DTC监测指数": 33.4
            },
            {
              "季度": "2020Q1",
              "FICC监测指数": 98.4,
              "ECS相关代理指数": 98.4,
              "NSCC监测指数": 98.0,
              "DTC监测指数": 98.4
            }
          ],
          "methods": [
            {
              "language": "calculation",
              "code": "压力分位=100×参考季度中压力不高于当前值的比例；非正压力分位为0。业务指数=Σ(压力分位×归一化最大绝对Spearman权重)。ECS相关代理=max(NSCC指数,DTC指数)。"
            }
          ]
        }
      ]
    },
