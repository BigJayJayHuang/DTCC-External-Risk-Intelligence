# Original AWS receipts contain the SSO principal identity. Share the sanitized
# usage receipt and source-checked facts, not local authentication metadata.
aws_reading/
# Original publisher bodies remain in the local evidence cache. The review branch
# shares findings, hashes and a body-stripped database rather than entire websites.
evidence/
inputs/*.txt
data/*.sqlite3
data/*.sqlite3-wal
data/*.sqlite3-shm
proxy_v/data/*.sqlite3
proxy_v/data/*.sqlite3-wal
proxy_v/data/*.sqlite3-shm
proxy_v/data/*.sqlite3.lock
# The reproducible import payload duplicates CSVs and the public database.
proxy_v/results/database_payload.json
